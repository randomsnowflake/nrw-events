# Copy this file to `.env` and fill in the keys/settings you want.
# The tool runs without API keys; deterministic public sources do the heavy lifting.
# Real environment variables take precedence over values from this file.

# Exa neural web search (https://exa.ai) — enables the broad-web event fallback.
EXA_API_KEY=

# xAI Grok (https://x.ai) — enables the optional agentic search sweep.
# Also requires NRW_EVENTS_ENABLE_GROK=1 at runtime.
XAI_API_KEY=
NRW_EVENTS_ENABLE_GROK=0

# Two-stage AI fact extraction and neutral summaries. It runs only for the
# legally restricted source allowlist in code. Successful results are cached
# forever by event content and pipeline version; failures are cached for 24h.
OPENAI_API_KEY=
# Alternative provider for model comparisons or production use.
OPENROUTER_API_KEY=
# NRW_EVENTS_AI_PROVIDER=openai
# NRW_EVENTS_AI_ENRICHMENT=1
# NRW_EVENTS_AI_MODEL=gpt-5.6-luna
# OpenRouter reasoning is independently configurable per stage. DeepSeek V4
# Flash supports none, low, high and max; each combination has its own cache.
# NRW_EVENTS_AI_FACTS_REASONING_EFFORT=none
# NRW_EVENTS_AI_SUMMARY_REASONING_EFFORT=low
# NRW_EVENTS_AI_CACHE_DB=~/.local/state/nrw-events/ai-enrichment.sqlite3
# Optional website export of exact-match content_reviewed summary rules.
# Malformed configured manifests fail closed; absent means no reviewed input.
# NRW_EVENTS_REVIEWED_AI_SUMMARIES_PATH=/state/editorial-event-overrides.json
# NRW_EVENTS_AI_MAX_ATTEMPTS=2
# NRW_EVENTS_AI_NEGATIVE_CACHE_HOURS=168
# NRW_EVENTS_AI_TIMEOUT_SECONDS=180
# Whole-publication AI budget after validation, filtering and global dedup.
# NRW_EVENTS_AI_BATCH_TIMEOUT_SECONDS=600
# NRW_EVENTS_AI_WORKERS=8
# NRW_EVENTS_AI_MAX_EVENTS=0
# NRW_EVENTS_AI_MAX_NEW_CACHE_ROWS_PER_DAY=150

# Output paths default to $XDG_STATE_HOME/nrw-events (or
# ~/.local/state/nrw-events when XDG_STATE_HOME is unset).
# Detail caches default to $XDG_CACHE_HOME/nrw-events (or ~/.cache/nrw-events).
# NRW_EVENTS_JSON_OUT=~/.local/state/nrw-events/nrw-events-latest.json
# NRW_EVENTS_META_JSON_OUT=~/.local/state/nrw-events/nrw-events-latest-meta.json
# NRW_EVENTS_HIGHLIGHTS_JSON_OUT=~/.local/state/nrw-events/highlights.json
# NRW_EVENTS_SERIES_LEDGER_JSON=~/.local/state/nrw-events/series-ledger.json
# Optional durable last-published metadata used to retain unexpired events when
# an individual source is temporarily unavailable. Defaults to META_JSON_OUT.
NRW_EVENTS_PREVIOUS_META_JSON=

# Report filtering. 0/unset means show every deduplicated relevant event.
# NRW_EVENTS_DAYS_AHEAD=3
# NRW_EVENTS_MAX_PER_SECTION=0
# NRW_EVENTS_REPORT_MAX_CHARS=0
# NRW_EVENTS_SCORE_FLOOR=0.4
# NRW_EVENTS_RADIUS_KM=75
# NRW_EVENTS_CATEGORIES=market,festival
# NRW_EVENTS_FREE_ONLY=0
# NRW_EVENTS_JSON_STDOUT=0
# Optional reviewed category fallback cache (schema version 1). No external or
# LLM classifier is called by nrw-events.
# NRW_EVENTS_CATEGORY_FALLBACK_CACHE=~/.local/state/nrw-events/category-fallback.json
# NRW_EVENTS_DESCRIPTION_MAX_CHARS=700

# Search fallback size. Exa returns roughly five results per query.
# NRW_EVENTS_EXA_QUERIES=10

# HTTP behaviour for public event sources.
# NRW_EVENTS_USER_AGENT=
# NRW_EVENTS_HTTP_RETRY_ATTEMPTS=5
# NRW_EVENTS_HTTP_RETRY_BASE_SECONDS=1.0
# NRW_EVENTS_HTTP_REQUEST_BUDGET_SECONDS=45.0
# NRW_EVENTS_HTTP_RETRY_MAX_DELAY_SECONDS=60.0
# NRW_EVENTS_HTTP_MAX_RESPONSE_BYTES=5000000
# NRW_EVENTS_SOURCE_WORKERS=4
# NRW_EVENTS_SOURCE_TIMEOUT_SECONDS=600.0
# NRW_EVENTS_SOURCE_PROCESSING_GRACE_SECONDS=180.0
# NRW_EVENTS_SOURCE_BASELINE_MIN_COUNT=10
# NRW_EVENTS_MINIMUM_SNAPSHOT_RATIO=0.5
# NRW_EVENTS_MAX_FAILED_SOURCE_RATIO=0.5
# NRW_EVENTS_BONN_DE_DELAY_SECONDS=2.0
# NRW_EVENTS_BONN_CALENDAR_MAX_PAGES=30
# Bright Data Web Unlocker credentials. The Monday-only vomFASS refresh always
# uses this proxy. Hofflohmärkte Köln and the allowlisted IONAS4 regional
# calendars remain direct-first and fall back only after rate limits, transient
# server errors, or exhausted direct-request timeouts.
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_ZONE=
# Event detail pages are cached per source. This protects municipal and venue
# servers when the website is rebuilt several times in a short period while
# still refreshing generic detail pages daily by default.
# Set to 0 to disable the shared detail-page enrichment pass.
# NRW_EVENTS_DETAIL_ENRICHMENT=1
# NRW_EVENTS_DETAIL_BATCH_TIMEOUT_SECONDS=45
# NRW_EVENTS_CACHE_DIR=~/.cache/nrw-events
# NRW_EVENTS_DETAIL_CACHE_TTL_HOURS=24
# NRW_EVENTS_BONN_DETAIL_DESCRIPTION_MAX_CHARS=500

# Optional durable logs for unattended runs. JSON logs are one object per line.
# NRW_EVENTS_LOG_LEVEL=INFO
# NRW_EVENTS_LOG_FILE=/var/log/nrw-events/import.log
# NRW_EVENTS_JSON_LOG_FILE=/var/log/nrw-events/import.jsonl
# Export NRW_EVENTS_PERFORMANCE=1 in the invoking shell for aggregate stderr metrics.
# This flag is read before the CLI loads an env file. Default: disabled.
# Pure keyword matching cache. Set to 0 to use the uncached implementation.
# NRW_EVENTS_TAXONOMY_CACHE=1
# Pure comparison-key cache. Set to 0 to disable it independently.
# NRW_EVENTS_NORMALIZATION_CACHE=1
# Skip full iCal construction only after the unchanged quality gate rejects it.
# NRW_EVENTS_ICAL_PRUNE=1

# Optional explicit env-file path for wrappers/callers.
# NRW_EVENTS_ENV_FILE=/absolute/path/to/.env
